# --- Supabase (required) ---
# From your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Geocoding / Places (required for Interactive Map, Route Planning) ---
# Nominatim (OpenStreetMap) is used by default and needs NO API key.
# It is free but rate-limited (~1 req/sec) and requires a custom User-Agent.
# Set this only if you switch to a paid/higher-quota provider (e.g. Mapbox, LocationIQ).
VITE_GEOCODING_PROVIDER=nominatim
VITE_GEOCODING_API_KEY=

# --- Routing (required for Route Planning / Comparison) ---
# OpenRouteService (openrouteservice.org) - free tier, requires a free API key.
# Used for walking/driving directions between points.
VITE_ROUTING_PROVIDER=openrouteservice
VITE_ORS_API_KEY=

# --- Map tiles (required for Interactive Map) ---
# Default: OpenStreetMap raster tiles, no key needed.
# Optional: swap to MapTiler/Mapbox for nicer styling.
VITE_MAP_TILE_PROVIDER=osm
VITE_MAPTILER_API_KEY=

# --- Optional: alternative providers you may swap in later ---
# VITE_MAPBOX_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=

# --- Server-side only secrets (used inside Supabase Edge Functions, NEVER in frontend) ---
# Set these with: supabase secrets set KEY=value
# ORS_SECRET_API_KEY=
# FUTURE_LLM_API_KEY=
